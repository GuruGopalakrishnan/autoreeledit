{
  "background_color": "#F0F0F0",
  "person_mode": "color",
  "bg_mode": "original",
  "default_style": "typewriter-glow",
  "keyword_list": ["energy", "important", "listen", "wait", "but", "however", "secret", "never", "huge", "crazy", "insane", "best", "worst", "mistake", "free", "results", "proof", "shocking"],
  "energetic_word_count": 5,
  "dramatic_hold_seconds": 2.0,
  "whisper_model": "small",
  "ffmpeg_path": "ffmpeg",
  "track_hands": true,
  "process_width": 1280,
  "process_height": 720,
  "output_width": 1080,
  "output_height": 1920,
  "fps": 30,
  "styles": {
    "typewriter-glow": {
      "font": "assets/fonts/Montserrat-Variable.ttf",
      "font_size": 46,
      "color": "#FFFFFF",
      "outline_color": null,
      "outline_width": 0,
      "bg_color": null,
      "position": "top",
      "animation": "typewriter",
      "text_glow": true,
      "blink_cursor": true
    },
    "corporate-lower-third": {
      "font": "assets/fonts/Anton-Regular.ttf",
      "font_size": 50,
      "color": "#FFFFFF",
      "outline_color": null,
      "outline_width": 0,
      "bg_color": "#2E3192",
      "position": "lower_third",
      "animation": "slide_in",
      "corporate_bar": true,
      "accent_color": "#00D4FF"
    },
    "name-tag": {
      "font": "assets/fonts/Montserrat-Variable.ttf",
      "font_size": 42,
      "color": "#FFFFFF",
      "outline_color": null,
      "outline_width": 0,
      "bg_color": "#8B5CF6",
      "position": "lower_third",
      "animation": "slide_in",
      "ribbon_tag": true,
      "accent_color": "#FFD400"
    },
    "cutout-title": {
      "font": "assets/fonts/Anton-Regular.ttf",
      "font_size": 90,
      "color": "#FFFFFF",
      "outline_color": "#000000",
      "outline_width": 3,
      "bg_color": null,
      "position": "center",
      "animation": "scale_punch_in",
      "text_behind_subject": true,
      "show_mask_edge": true,
      "mask_edge_color": "#FF0000",
      "mask_edge_width": 5
    },
    "black-pause": {
      "font": "assets/fonts/Anton-Regular.ttf",
      "font_size": 84,
      "color": "#FFFFFF",
      "outline_color": null,
      "outline_width": 0,
      "bg_color": null,
      "position": "beside_person",
      "animation": "scale_punch_in",
      "full_frame_bg_color": "#000000"
    },
    "starburst-moment": {
      "font": "assets/fonts/Anton-Regular.ttf",
      "font_size": 58,
      "color": "#FFFFFF",
      "outline_color": "#000000",
      "outline_width": 4,
      "bg_color": null,
      "position": "lower_third",
      "animation": "scale_punch_in",
      "show_starburst": true
    },
    "dramatic": {
      "font": "assets/fonts/Anton-Regular.ttf",
      "font_size": 120,
      "color": "#FF0000",
      "outline_color": "#000000",
      "outline_width": 4,
      "bg_color": null,
      "position": "beside_person",
      "animation": "scale_punch_in",
      "show_starburst": true
    },
    "energetic": {
      "font": "assets/fonts/Montserrat-Italic-Variable.ttf",
      "font_size": 60,
      "color": "#CCFF00",
      "outline_color": "#000000",
      "outline_width": 2,
      "bg_color": "#FF6B00",
      "position": "dynamic",
      "animation": "slide_in"
    },
    "spotlight-reveal": {
      "font": "assets/fonts/Anton-Regular.ttf",
      "font_size": 64,
      "color": "#FFD97A",
      "outline_color": "#000000",
      "outline_width": 3,
      "bg_color": null,
      "position": "lower_third",
      "animation": "word_fade_in",
      "spotlight_moment": true
    },
    "flash-hit": {
      "font": "assets/fonts/Anton-Regular.ttf",
      "font_size": 96,
      "color": "#FFFFFF",
      "outline_color": "#CC0000",
      "outline_width": 5,
      "bg_color": null,
      "position": "center",
      "animation": "scale_punch_in",
      "flash_moment": true
    },
    "confetti-pop": {
      "font": "assets/fonts/Anton-Regular.ttf",
      "font_size": 80,
      "color": "#FFD400",
      "outline_color": "#000000",
      "outline_width": 4,
      "bg_color": null,
      "position": "lower_third",
      "animation": "scale_punch_in",
      "confetti_moment": true
    },
    "glitch-cut": {
      "font": "assets/fonts/Anton-Regular.ttf",
      "font_size": 70,
      "color": "#00FFD1",
      "outline_color": "#FF00C8",
      "outline_width": 3,
      "bg_color": null,
      "position": "center",
      "animation": "scale_punch_in",
      "glitch_moment": true
    },
    "neon-frame": {
      "font": "assets/fonts/Montserrat-Variable.ttf",
      "font_size": 46,
      "color": "#00E5FF",
      "outline_color": "#00263A",
      "outline_width": 2,
      "bg_color": null,
      "position": "lower_third",
      "animation": "slide_in",
      "neon_frame": true
    },
    "zoom-punch": {
      "font": "assets/fonts/Anton-Regular.ttf",
      "font_size": 88,
      "color": "#FFFFFF",
      "outline_color": "#000000",
      "outline_width": 4,
      "bg_color": null,
      "position": "center",
      "animation": "scale_punch_in",
      "zoom_punch": true
    },
    "color-pop": {
      "font": "assets/fonts/Montserrat-Variable.ttf",
      "font_size": 46,
      "color": "#FFFFFF",
      "outline_color": "#000000",
      "outline_width": 3,
      "bg_color": "#E63946",
      "position": "lower_third",
      "animation": "word_fade_in",
      "color_pop": true
    },
    "ribbon-banner": {
      "font": "assets/fonts/Anton-Regular.ttf",
      "font_size": 50,
      "color": "#FFFFFF",
      "outline_color": null,
      "outline_width": 0,
      "bg_color": "#E63946",
      "position": "top",
      "animation": "word_fade_in",
      "ribbon_bar": true
    },
    "shake-impact": {
      "font": "assets/fonts/Anton-Regular.ttf",
      "font_size": 92,
      "color": "#FFEE00",
      "outline_color": "#000000",
      "outline_width": 5,
      "bg_color": null,
      "position": "center",
      "animation": "scale_punch_in",
      "shake_moment": true
    },
    "vignette-focus": {
      "font": "assets/fonts/Montserrat-Italic-Variable.ttf",
      "font_size": 48,
      "color": "#F5F5F5",
      "outline_color": "#000000",
      "outline_width": 2,
      "bg_color": null,
      "position": "lower_third",
      "animation": "word_fade_in",
      "vignette_moment": true
    }
  },
  "title_moment_presets": [
    "cutout-title",
    "black-pause",
    "starburst-moment",
    "spotlight-reveal",
    "flash-hit",
    "confetti-pop",
    "glitch-cut",
    "neon-frame",
    "zoom-punch",
    "color-pop",
    "ribbon-banner",
    "shake-impact",
    "vignette-focus"
  ]
}
