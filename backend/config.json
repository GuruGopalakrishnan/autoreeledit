{
  "background_color": "#F0F0F0",
  "person_mode": "color",
  "bg_mode": "solid",
  "default_style": "clean-white",
  "keyword_list": ["energy", "important", "listen", "wait", "but", "however", "secret", "never", "huge", "crazy", "insane", "best", "worst", "mistake", "free", "results", "proof", "shocking"],
  "energetic_word_count": 5,
  "dramatic_hold_seconds": 2.0,
  "whisper_model": "small",
  "ffmpeg_path": "ffmpeg",
  "track_hands": true,
  "process_width": 1280,
  "process_height": 720,
  "output_width": 1080,
  "output_height": 1920,
  "fps": 30,
  "styles": {
    "clean-white": {
      "font": "assets/fonts/Montserrat-Variable.ttf",
      "font_size": 44,
      "color": "#FFFFFF",
      "outline_color": "#000000",
      "outline_width": 3,
      "bg_color": null,
      "position": "lower_third",
      "animation": "word_fade_in"
    },
    "yellow-pop": {
      "font": "assets/fonts/Montserrat-Variable.ttf",
      "font_size": 48,
      "color": "#FFD400",
      "outline_color": "#000000",
      "outline_width": 3,
      "bg_color": null,
      "position": "lower_third",
      "animation": "scale_punch_in"
    },
    "green-highlight": {
      "font": "assets/fonts/Montserrat-Variable.ttf",
      "font_size": 42,
      "color": "#FFFFFF",
      "outline_color": null,
      "outline_width": 0,
      "bg_color": "#1FAA59",
      "position": "lower_third",
      "animation": "slide_in"
    },
    "bold-outline": {
      "font": "assets/fonts/Anton-Regular.ttf",
      "font_size": 56,
      "color": "#FFFFFF",
      "outline_color": "#000000",
      "outline_width": 5,
      "bg_color": null,
      "position": "lower_third",
      "animation": "scale_punch_in"
    },
    "neon-glow": {
      "font": "assets/fonts/Montserrat-Variable.ttf",
      "font_size": 44,
      "color": "#39FF14",
      "outline_color": null,
      "outline_width": 0,
      "bg_color": "#111111",
      "position": "lower_third",
      "animation": "slide_in"
    },
    "minimal-thin": {
      "font": "assets/fonts/Montserrat-Variable.ttf",
      "font_size": 32,
      "color": "#CCCCCC",
      "outline_color": null,
      "outline_width": 0,
      "bg_color": null,
      "position": "top",
      "animation": "typewriter"
    },
    "big-word": {
      "font": "assets/fonts/Anton-Regular.ttf",
